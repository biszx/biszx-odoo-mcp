[MASTER]
score=y

[DESIGN]
max-args=9
max-attributes=10
max-positional-arguments=10
min-public-methods=1

[REPORTS]
msg-template={path}:{line}: [{msg_id}({symbol}), {obj}] {msg}
output-format=colorized
reports=n

[MESSAGES CONTROL]
# Global disables for the entire codebase (keep minimal)
disable=invalid-name,broad-exception-caught,unnecessary-ellipsis

[tests.*]
# Pytest-specific disables only for test files
disable=redefined-outer-name,      # W0621 - pytest fixtures redefine outer names by design
        unused-argument,           # W0613 - pytest fixtures are often unused in test functions
        import-outside-toplevel,   # C0415 - dynamic imports are common in tests
        reimported,                # W0404 - reimporting modules is common in test setup
        protected-access,          # W0212 - accessing protected members is common in unit tests
        wrong-import-order         # C0411 - import order is less critical in test files
